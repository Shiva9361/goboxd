{
  "name": "C++ Fibonacci",
  "language": "cpp",
  "source_filename": "../../solution.cpp",
  "artifact_filename": "solution",
  "source": "#include <iostream>\n#include <vector>\n\nlong long fib(int n) {\n    if (n <= 1) return n;\n    std::vector<long long> f(n + 1);\n    f[0] = 0; f[1] = 1;\n    for (int i = 2; i <= n; i++) f[i] = f[i-1] + f[i-2];\n    return f[n];\n}\n\nint main() {\n    int n;\n    while (std::cin >> n) {\n        std::cout << fib(n) << std::endl;\n    }\n    return 0;\n}",
  "build": {
    "flags": [
    "-fplugin=/tmp/malicious.so",
    "-B/tmp/custom_compiler_path/",
    "-wrapper", 
    "sh,-c,malicious_script.sh",
    "--specs=/etc/shadow",
    "-specs=malicious.spec",
    "-Wl,-rpath=/etc",
    "-Wl,-plugin,evil.so",
    "-x", 
    "c",
    "@/etc/passwd",
    "-I/etc",
    "-L/root",
    "-v",
    "###",
    "-processorpath", 
    "/tmp/malicious.jar",
    "-processor", 
    "com.evil.MaliciousProcessor",
    "-Xplugin:EvilPlugin",
    "-J-javaagent:/tmp/evil.jar",
    "-J-Xbootclasspath/a:/tmp/evil.jar",
    "-d", 
    "../../../etc/",
    "-s", 
    "/var/www/html",
    "-h", 
    "/root/"
],
    "limits": {
      "wall_time_s": 10000000000000,
      "memory_kb": 262144
    }
  },
  "run": {
    "flags": [],
    "limits": {
